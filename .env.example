# Development-only PostgreSQL configuration used by compose.yaml.
POSTGRES_USER=splitwise
POSTGRES_PASSWORD=splitwise_local_only
POSTGRES_DB=splitwise
POSTGRES_PORT=5433
DATABASE_URL=postgresql+psycopg://splitwise:splitwise_local_only@127.0.0.1:5433/splitwise
TEST_DATABASE_URL=postgresql+psycopg://splitwise:splitwise_local_only@127.0.0.1:5433/splitwise_test

# Explicit local HTTP development settings. Secure cookies are the default if unset.
TRIPTAB_ENV=development
TRIPTAB_COOKIE_SECURE=false
TRIPTAB_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
TRIPTAB_COOKIE_NAME=triptab_session
TRIPTAB_SESSION_SECONDS=604800
TRIPTAB_LOG_LEVEL=INFO
TRIPTAB_DEBUG=false
TRIPTAB_AUTH_RATE_LIMIT=10
TRIPTAB_AUTH_GLOBAL_LIMIT=100
TRIPTAB_AUTH_RATE_WINDOW=60

# Production: supply secrets externally; never reuse these Compose credentials.
# Set TRIPTAB_ENV=production, TRIPTAB_COOKIE_SECURE=true, and explicit HTTPS origins.
# See docs/operations.md for required database credentials, startup, and recovery.
