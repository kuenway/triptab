# Development-only PostgreSQL configuration used by compose.yaml.
POSTGRES_USER=triptab
POSTGRES_PASSWORD=triptab_local_only
POSTGRES_DB=triptab
POSTGRES_PORT=5433
DATABASE_URL=postgresql+psycopg://triptab:triptab_local_only@127.0.0.1:5433/triptab
TEST_DATABASE_URL=postgresql+psycopg://triptab:triptab_local_only@127.0.0.1:5433/triptab_test

# Explicit local HTTP development settings. Secure cookies are the default if unset.
TRIPTAB_ENV=development
TRIPTAB_COOKIE_SECURE=false
TRIPTAB_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
TRIPTAB_COOKIE_NAME=triptab_session
TRIPTAB_SESSION_SECONDS=604800
TRIPTAB_LOG_LEVEL=INFO
TRIPTAB_DEBUG=false
TRIPTAB_AUTH_RATE_LIMIT=10
TRIPTAB_AUTH_GLOBAL_LIMIT=100
TRIPTAB_AUTH_RATE_WINDOW=60

# Production: supply secrets externally; never reuse these Compose credentials.
# Set TRIPTAB_ENV=production, TRIPTAB_COOKIE_SECURE=true, and explicit HTTPS origins.
# See docs/operations.md for required database credentials, startup, and recovery.

# Recovery is OFF by default. The backend gate is authoritative.
TRIPTAB_PASSWORD_RECOVERY_ENABLED=false
# Export to the frontend process or set in frontend/.env.local (build-time visibility only).
NEXT_PUBLIC_TRIPTAB_PASSWORD_RECOVERY_ENABLED=false
# Enabled local tests use an injected in-memory sender; no real delivery.
TRIPTAB_PASSWORD_RESET_EMAIL_PROVIDER=disabled
TRIPTAB_FRONTEND_BASE_URL=http://localhost:3000
# Production only, supplied outside Git after separate provider/domain setup:
# TRIPTAB_PASSWORD_RESET_EMAIL_PROVIDER=resend
# RESEND_API_KEY=<set in backend provider secret storage; never in Git>
# TRIPTAB_PASSWORD_RESET_FROM_EMAIL=<verified sender email>
# TRIPTAB_FRONTEND_BASE_URL=<exact allowed HTTPS frontend origin>
